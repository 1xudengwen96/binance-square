# Only the variables below are actually read by the code. Everything else — Square key,
# AI base URL / model / key, posting cadence, per-account settings — lives in the SQLite
# file and is edited in the panel, so it deliberately has no env var here.

# --- local server ---
PORT=8787
# Leave unset on your own machine (defaults to 127.0.0.1). The Docker image sets
# 0.0.0.0 because a container's loopback is unreachable from the host.
# HOST=0.0.0.0
# Set true to allow mutations through a public IP / hostname. Compose enables this.
# ALLOW_REMOTE_ACCESS=false
# Panel login (required by Docker Compose; also enables login for native runs).
# Applied at startup. Recreate the container after changing these values.
PUBLIC_AUTH_USERNAME=admin
PUBLIC_AUTH_PASSWORD=

# --- storage ---
DB_PATH=./data/squareforge.db

# --- optional S3 backup bootstrap (normally configured in 备份与迁移) ---
# The panel saves S3 configuration in data/backup-config.json with mode 0600.
# AWS credentials are never included in S3 backup archives or returned by the API.
# AWS_REGION=ap-northeast-1
# S3_BACKUP_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Binance Square publishing ---
# The Square creator key (post-only), NOT your trading API key. Normally set per account
# in the 「账号」 page; this env fallback only serves the single-account / CLI path.
# SQUARE_API_KEY=

# --- optional LLM polish ---
# Normally set in the 「接入与 AI」 page. Env fallback for the CLI:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
